{
  "name": "vcx-cli",
  "version": "0.2.1",
  "description": "Named Vercel CLI accounts on one device",
  "type": "module",
  "bin": {
    "vcx": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node --eval \"import('node:fs/promises').then(fs => fs.chmod('dist/cli.js', 0o755))\"",
    "clean": "node --eval \"import('node:fs/promises').then(fs => fs.rm('dist', { recursive: true, force: true }))\"",
    "test": "npm run clean && npm run build && node --test test/cli.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "vercel",
    "cli",
    "accounts",
    "profiles"
  ],
  "license": "MIT",
  "author": "akrupa-appto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akrupa-appto/vcx.git"
  },
  "bugs": {
    "url": "https://github.com/akrupa-appto/vcx/issues"
  },
  "homepage": "https://github.com/akrupa-appto/vcx#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.17.57",
    "typescript": "^5.9.3"
  }
}
